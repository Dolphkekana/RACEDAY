@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-head">
    <p class="eyebrow">Organiser</p>
    <h1>Dashboard</h1>
    <p class="lead">Events you have created, how many people have entered, and which start dates are still ahead.</p>
</section>

<div class="stat-grid">
    <article class="stat-card">
        <span class="stat-icon"><i class="bi bi-flag" aria-hidden="true"></i></span>
        <div>
            <p class="eyebrow">Events</p>
            <p class="metric-value">@Model.EventCount</p>
        </div>
    </article>
    <article class="stat-card">
        <span class="stat-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
        <div>
            <p class="eyebrow">Enrolments</p>
            <p class="metric-value">@Model.EnrolmentCount</p>
        </div>
    </article>
    <article class="stat-card">
        <span class="stat-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></span>
        <div>
            <p class="eyebrow">Upcoming</p>
            <p class="metric-value">@Model.UpcomingEventCount</p>
        </div>
    </article>
</div>

<section class="panel">
    <div class="section-heading">
        <h2>Your events</h2>
        <a class="btn btn-primary" asp-controller="ManageEvents" asp-action="Create">Create event</a>
    </div>
    @if (Model.Events.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-flag" aria-hidden="true"></i>
            <p class="meta">You have not created an event yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Enrolments</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var raceEvent in Model.Events)
                    {
                        <tr>
                            <td><a asp-controller="ManageEvents" asp-action="Edit" asp-route-id="@raceEvent.EventId">@raceEvent.Name</a></td>
                            <td>@raceEvent.EventDate.ToString("d MMMM yyyy")</td>
                            <td>@raceEvent.Location</td>
                            <td><span class="chip">@raceEvent.EventType</span></td>
                            <td>@raceEvent.EnrolmentCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
