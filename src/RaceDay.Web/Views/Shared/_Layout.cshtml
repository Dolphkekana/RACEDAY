<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="container header-row">
            <a class="brand" asp-controller="Home" asp-action="Index">RaceDay</a>
            <nav class="main-nav" aria-label="Primary">
                <a asp-controller="Home" asp-action="Index">Events</a>
                @if (Context.Session.GetInt32(AppSession.UserId) is null)
                {
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                    <a asp-controller="Account" asp-action="Register">Register</a>
                }
                else
                {
                    <span class="nav-user">@Context.Session.GetString(AppSession.DisplayName)</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="nav-logout">
                        <button class="linkish" type="submit">Sign out</button>
                    </form>
                }
            </nav>
        </div>
    </header>
    <main class="container page-content">
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">@successMessage</div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">RaceDay community road events</div>
    </footer>
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
</body>
</html>
