@model EventFilterViewModel
@{
    ViewData["Title"] = "Upcoming events";
}

<section class="race-hero">
    <div>
        <p class="eyebrow">Upcoming events</p>
        <h1>Find your next start line.</h1>
        <p class="lead">Browse road runs, walks, and rides across South Africa. Filter by name, type, place, or distance.</p>
        <div class="hero-actions">
            <a class="btn btn-amber" href="#event-filters">Filter events</a>
            @if (Context.Session.GetInt32(AppSession.UserId) is null)
            {
                <a class="btn btn-outline-ink" asp-controller="Account" asp-action="Register">Create an account</a>
            }
        </div>
    </div>
    <div class="track-card" aria-hidden="true">
        <strong>Race weekend</strong>
        <span>Runs, walks, and rides on one start list.</span>
        <div class="lane"><span></span></div>
        <div class="lane"><span style="width:46%"></span></div>
        <div class="lane"><span style="width:82%"></span></div>
    </div>
</section>

<form id="event-filters" method="get" class="filter-panel">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Event name" />
        </div>
        <div class="col-md-2">
            <label asp-for="EventTypeId" class="form-label"></label>
            <select asp-for="EventTypeId" class="form-select">
                <option value="">All types</option>
                @foreach (var eventType in Model.EventTypes)
                {
                    <option value="@eventType.EventTypeId">@eventType.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="MinDistance" class="form-label"></label>
            <input asp-for="MinDistance" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="MaxDistance" class="form-label"></label>
            <input asp-for="MaxDistance" class="form-control" />
        </div>
        <div class="col-12">
            <button class="btn btn-primary" type="submit">Apply filters</button>
            <a class="btn btn-link" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <section class="panel empty-state">
        <i class="bi bi-calendar-x" aria-hidden="true"></i>
        <h2>No upcoming events match those filters.</h2>
        <p class="meta">Try a wider search, or check back when organisers publish the next race.</p>
    </section>
}
else
{
    <div class="event-grid">
        @foreach (var raceEvent in Model.Events)
        {
            var banner = MediaUrls.ForBrowser(Context, raceEvent.BannerImageUrl);
            <article class="event-card">
                <div class="event-media">
                    @if (banner is null)
                    {
                        <div class="banner-fallback">@raceEvent.EventType</div>
                    }
                    else
                    {
                        <img src="@banner" alt="Banner for @raceEvent.Name" />
                    }
                    <div class="date-badge">
                        <span class="date-day">@raceEvent.EventDate.ToString("dd")</span>
                        <span class="date-month">@raceEvent.EventDate.ToString("MMM")</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chip-row">
                        <span class="chip"><i class="bi bi-signpost-2" aria-hidden="true"></i> @raceEvent.EventType</span>
                        <span class="chip chip-gold">@raceEvent.DistanceKm.ToString("0.##") km</span>
                    </div>
                    <h2><a asp-controller="Events" asp-action="Details" asp-route-id="@raceEvent.EventId">@raceEvent.Name</a></h2>
                    <p class="location-line meta"><i class="bi bi-geo-alt" aria-hidden="true"></i> @raceEvent.Location</p>
                    <a class="btn btn-primary mt-2" asp-controller="Events" asp-action="Details" asp-route-id="@raceEvent.EventId">View event</a>
                </div>
            </article>
        }
    </div>
}
