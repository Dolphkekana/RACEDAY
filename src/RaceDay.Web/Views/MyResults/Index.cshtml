@model IReadOnlyList<ResultModel>
@{
    ViewData["Title"] = "My results";
}

<section class="hero">
    <p class="eyebrow">Participant</p>
    <h1>My results</h1>
    <p class="lead">Finish times and positions recorded by the organiser after each event.</p>
</section>

@if (Model.Count == 0)
{
    <section class="panel">
        <h2>No results have been published for you yet.</h2>
        <p class="meta">Results appear here once the organiser captures them.</p>
    </section>
}
else
{
    <section class="panel">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model)
                {
                    <tr>
                        <td>@result.EventName</td>
                        <td>@result.EventDate.ToString("d MMMM yyyy")</td>
                        <td>@result.CategoryName</td>
                        <td>@RaceDayFormat.FinishTime(result.FinishTime)</td>
                        <td>@RaceDayFormat.Placement(result.FinishingPosition, result.FinisherCount)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
