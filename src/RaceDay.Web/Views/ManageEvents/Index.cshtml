@model IReadOnlyList<EventModel>
@{
    ViewData["Title"] = "Manage events";
}

<section class="page-head">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Organiser</p>
            <h1>Events</h1>
        </div>
        <a class="btn btn-primary" asp-action="Create">Create event</a>
    </div>
</section>

@if (Model.Count == 0)
{
    <section class="panel empty-state">
        <i class="bi bi-calendar-plus" aria-hidden="true"></i>
        <h2>You have not created an event yet.</h2>
        <a class="btn btn-primary" asp-action="Create">Create your first event</a>
    </section>
}
else
{
    <section class="panel">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var raceEvent in Model)
                    {
                        <tr>
                            <td>
                                <strong>@raceEvent.Name</strong>
                                <div class="meta">@raceEvent.EventType</div>
                            </td>
                            <td>@raceEvent.EventDate.ToString("d MMM yyyy")</td>
                            <td>@raceEvent.Location</td>
                            <td>@raceEvent.DistanceKm.ToString("0.##") km</td>
                            <td>
                                <div class="action-pills">
                                    <a asp-action="Edit" asp-route-id="@raceEvent.EventId">Edit</a>
                                    <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@raceEvent.EventId">Categories</a>
                                    <a asp-controller="Enrolments" asp-action="Index" asp-route-eventId="@raceEvent.EventId">Entries</a>
                                    <a asp-controller="RaceResults" asp-action="Index" asp-route-eventId="@raceEvent.EventId">Results</a>
                                    <form asp-action="Delete" asp-route-id="@raceEvent.EventId" method="post" class="inline-form" onsubmit="return confirm('Delete this event?');">
                                        <button class="link-danger" type="submit">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
